# Public config (safe for client)
NEXT_PUBLIC_SITE_URL=https://bangunwebsite.id
NEXT_PUBLIC_WHATSAPP_NUMBER=6282151928443
NEXT_PUBLIC_WHATSAPP_DEFAULT_TEXT=Halo BangunWebsite.id, saya ingin konsultasi tentang website, maintenance, atau kebutuhan IT.
NEXT_PUBLIC_WHATSAPP_PORTFOLIO_TEXT=Halo Bangunwebsite.id! Saya tertarik untuk konsultasi gratis setelah melihat portfolio Anda. Mohon informasi lebih lanjut.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/bangunwebsite_id/

# Server config (replace with your own values, never expose real secrets)
DB_URL=postgresql://USER:PASSWORD@HOST:5432/
APP_DB_URL=postgresql://USER:PASSWORD@HOST:5432/bangun_website
ADMIN_SESSION_SECRET=replace-with-long-random-secret
APP_TIMEZONE=Asia/Makassar

# Optional admin seed for setup script
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=replace-with-strong-password

# CDN storage (S3/MinIO compatible)
MINIO_ENDPOINT=cdn.bangunwebsite.id
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=bangunwebsite
MINIO_PUBLIC_BASE_URL=https://cdn.bangunwebsite.id/bangunwebsite
# Object path prefix inside bucket (e.g. assets/2026/05/file.jpg)
MINIO_OBJECT_PREFIX=assets
